# ==============================================================================
# TeamApo Hub — Frontend Environment Variables (.env.example)
# ==============================================================================
# SECURITY NOTICE (VULN-03):
# Any variable prefixed with `VITE_` is embedded into the public client-side
# JavaScript bundle (`dist/assets/index-*.js`) during `bun run build`.
#
# NEVER place private backend secrets, service account keys, Resend API keys,
# or admin credentials in `VITE_*` variables. Backend secrets belong exclusively
# in Firebase Cloud Functions Secret Manager (`RESEND_API_KEY`, `SUPERUSER_EMAIL`).
# ==============================================================================

# Public Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=your-public-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_REGION=asia-southeast2

# Optional Public Geoapify API Key (for venue autocomplete; falls back to OpenStreetMap Nominatim)
VITE_GEOAPIFY_API_KEY=

# Local Development Emulator Toggle ('true' | 'false')
VITE_USE_EMULATOR=false
