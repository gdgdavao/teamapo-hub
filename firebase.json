{
  "projects": {
    "default": "apohub-gdgdvo"
  },
  "rules": {
    "rules": "firestore.rules"
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": {
      "rules": "firestore.rules"
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "region": "asia-southeast1",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        
      ],
      "runtime": "python313"
    }
  ]
}
