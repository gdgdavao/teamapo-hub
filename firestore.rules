rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    function isOrganizer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'organizer'];
    }
    function isValidEmail(email) { return email is string && email.matches('.*@.*[.].*'); }
    function canManageEvent(eventId) { return isAdmin() || isOrganizer(); }

    function hasPerm(domain, action) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('permissions' in user) ||
             !(domain in user.permissions) ||
             !(action in user.permissions[domain]) ||
             user.permissions[domain][action] == true;
    }

    // Communal event model: active organizers with appropriate domain permissions
    // can manage event resources regardless of creator identity.
    function canManageDocByEventId(data) {
      return isAdmin() || isOrganizer();
    }

    // Prevent exposing non-empty promoCodes arrays on public /events/{eventId} documents.
    // Promo codes must reside in /events/{eventId}/config/promoCodes.
    function hasNoPublicPromoCodes(data) {
      return !('promoCodes' in data) || (data.promoCodes is list && data.promoCodes.size() == 0);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidEmail(request.resource.data.email) &&
        request.resource.data.role in ['admin', 'organizer'];
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isActive == resource.data.isActive &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phoneNumber', 'organization', 'bio', 'skills', 'socialLinks', 'updatedAt'
        ]));

      // No client, not even an admin, may delete a user document. Removing the
      // document alone leaves the Firebase Auth account alive (the account
      // could still sign in) and drops the audit entry that the deleteUser
      // callable writes. Deletion is a two-halves operation (Auth identity AND
      // profile document) and belongs to the Admin SDK: the `deleteUser`
      // callable in functions/main.py, which the Admin SDK path bypasses rules.
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if (('isPublished' in resource.data) && resource.data.isPublished == true && resource.data.status in ['published', 'ongoing']) ||
        isAdmin() || isOrganizer();
      allow create: if (isAdmin() || (isOrganizer() && hasPerm('events', 'canCreate'))) &&
        hasNoPublicPromoCodes(request.resource.data);
      allow update: if (isAdmin() || (
        isOrganizer() &&
        hasPerm('events', 'canUpdate') &&
        !(resource.data.status in ['completed', 'cancelled'])
      )) && hasNoPublicPromoCodes(request.resource.data);
      allow delete: if isAdmin();
      match /forms/{formId} {
        allow read: if get(/databases/$(database)/documents/events/$(eventId)).data.isPublished == true || canManageEvent(eventId);
        allow write: if isAdmin() || (isOrganizer() && hasPerm('events', 'canUpdate') && !(get(/databases/$(database)/documents/events/$(eventId)).data.status in ['completed', 'cancelled']));
      }
      match /config/{configId} {
        allow read: if canManageEvent(eventId);
        allow write: if isAdmin() || (isOrganizer() && hasPerm('events', 'canUpdate') && !(get(/databases/$(database)/documents/events/$(eventId)).data.status in ['completed', 'cancelled']));
      }
    }

    // PROMO CODES: Completely lock down direct client access to any top-level promocodes collection.
    match /promocodes/{codeId} {
      allow read, write: if false;
    }

    match /registrations/{registrationId} {
      allow read: if canManageDocByEventId(resource.data) && (isAdmin() || hasPerm('attendees', 'canRead'));
      allow create: if canManageEvent(request.resource.data.eventId) &&
        (isAdmin() || hasPerm('attendees', 'canUpdate')) &&
        request.resource.data.eventId is string &&
        ('userDetails' in request.resource.data) &&
        isValidEmail(request.resource.data.userDetails.email);
      allow update: if isAdmin() || (
        isOrganizer() &&
        hasPerm('attendees', 'canUpdate') &&
        request.resource.data.eventId == resource.data.eventId
      );
      allow delete: if isAdmin() || (isOrganizer() && hasPerm('attendees', 'canDelete'));
    }

    match /certificateTemplates/{templateId} {
      allow read: if true;
      allow create: if isAdmin() || (isOrganizer() && hasPerm('certificates', 'canManage'));
      allow update, delete: if isAdmin() || (isOrganizer() && hasPerm('certificates', 'canManage'));
    }
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationCount']) &&
        request.resource.data.verificationCount == resource.data.verificationCount + 1;
      allow delete: if isAdmin();
    }
    match /feedbackTokens/{tokenId} { allow read, write: if false; }
    match /feedback/{feedbackId} { allow read: if canManageDocByEventId(resource.data) && (isAdmin() || hasPerm('feedback', 'canRead')); allow create, update, delete: if false; }
    match /activity_logs/{logId} { allow read: if canManageDocByEventId(resource.data); allow create, update, delete: if false; }
    match /audit_logs/{logId} { allow read, write: if false; }
    match /event_analytics/{analyticsId} {
      allow read: if canManageEvent(analyticsId);
      allow write: if false;
    }
    match /paymentProofs/{proofId} {
      allow read: if ('eventId' in resource.data) && resource.data.eventId is string && (isAdmin() || (isOrganizer() && hasPerm('payments', 'canVerify')));
      allow create: if false;
      allow update: if ('eventId' in resource.data) && ('eventId' in request.resource.data) &&
        resource.data.eventId == request.resource.data.eventId && (isAdmin() || (isOrganizer() && hasPerm('payments', 'canVerify')));
      allow delete: if ('eventId' in resource.data) && resource.data.eventId is string && (isAdmin() || (isOrganizer() && hasPerm('payments', 'canVerify')));
    }
    match /system/{docId} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
