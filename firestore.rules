rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    function isOrganizer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'organizer'];
    }
    function isValidEmail(email) { return email is string && email.matches('.*@.*[.].*'); }
    function ownsEvent(eventId) {
      return isOrganizer() && exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.organizer.uid == request.auth.uid;
    }
    function canManageEvent(eventId) { return isAdmin() || ownsEvent(eventId); }

    function hasPerm(domain, action) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !('permissions' in user) ||
             !(domain in user.permissions) ||
             !(action in user.permissions[domain]) ||
             user.permissions[domain][action] == true;
    }

    // Attendee-owner check for flat collections whose docs embed their eventId
    // (registrations, feedback, activity_logs). Data Privacy Act 2012: an organizer
    // must only ever see their own event's attendees.
    // Primary path is O(1) on the denormalized organizerUid. The second clause is a
    // fallback for docs written before the backfill — they still resolve via event
    // ownership. Run scripts/backfill-organizer-uid.cjs before relying on the first.
    function ownsDocByEventId(data) {
      // `in` is required: reading an absent key is a rules *error*, not false.
      // The rules grammar has no `not in`, hence the ternary.
      return ('organizerUid' in data)
        ? data.organizerUid == request.auth.uid
        : (data.eventId is string && ownsEvent(data.eventId));
    }
    function canManageDocByEventId(data) {
      return isAdmin() || ownsDocByEventId(data);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidEmail(request.resource.data.email) &&
        request.resource.data.role in ['admin', 'organizer'];
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isActive == resource.data.isActive &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phoneNumber', 'organization', 'bio', 'skills', 'socialLinks', 'updatedAt'
        ]));

      // No client, not even an admin, may delete a user document. Removing the
      // document alone leaves the Firebase Auth account alive (the account
      // could still sign in) and drops the audit entry that the deleteUser
      // callable writes. Deletion is a two-halves operation (Auth identity AND
      // profile document) and belongs to the Admin SDK: the `deleteUser`
      // callable in functions/main.py, which the Admin SDK path bypasses rules.
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if (resource.data.isPublished == true && resource.data.status in ['published', 'ongoing']) || canManageEvent(eventId);
      allow create: if isAdmin() || (isOrganizer() && hasPerm('events', 'canCreate') && request.resource.data.organizer.uid == request.auth.uid);
      allow update: if isAdmin() || (
        ownsEvent(eventId) &&
        hasPerm('events', 'canUpdate') &&
        !(resource.data.status in ['completed', 'cancelled']) &&
        request.resource.data.organizer.uid == resource.data.organizer.uid
      );
      allow delete: if isAdmin() || (ownsEvent(eventId) && hasPerm('events', 'canDelete'));
      match /forms/{formId} {
        allow read: if get(/databases/$(database)/documents/events/$(eventId)).data.isPublished == true || canManageEvent(eventId);
        allow write: if isAdmin() || (ownsEvent(eventId) && hasPerm('events', 'canUpdate') && !(get(/databases/$(database)/documents/events/$(eventId)).data.status in ['completed', 'cancelled']));
      }
      match /config/{configId} {
        allow read: if canManageEvent(eventId);
        allow write: if isAdmin() || (ownsEvent(eventId) && hasPerm('events', 'canUpdate') && !(get(/databases/$(database)/documents/events/$(eventId)).data.status in ['completed', 'cancelled']));
      }
    }

    match /registrations/{registrationId} {
      allow read: if canManageDocByEventId(resource.data) && (isAdmin() || hasPerm('attendees', 'canRead'));
      allow create: if canManageEvent(request.resource.data.eventId) &&
        (isAdmin() || hasPerm('attendees', 'canUpdate')) &&
        request.resource.data.eventId is string &&
        ('userDetails' in request.resource.data) &&
        isValidEmail(request.resource.data.userDetails.email);
      allow update: if isAdmin() || (
        ownsDocByEventId(resource.data) &&
        hasPerm('attendees', 'canUpdate') &&
        request.resource.data.eventId == resource.data.eventId &&
        (!('organizerUid' in resource.data) || request.resource.data.organizerUid == resource.data.organizerUid)
      );
      allow delete: if isAdmin() || (ownsDocByEventId(resource.data) && hasPerm('attendees', 'canDelete'));
    }

    match /certificateTemplates/{templateId} {
      allow read: if true;
      // `resource` is unavailable on create, so create must read request.resource.data.
      // Templates with no eventId are global and stay organizer-editable, as before.
      allow create: if (isAdmin() || (isOrganizer() && hasPerm('certificates', 'canManage'))) &&
        (!('eventId' in request.resource.data) || ownsEvent(request.resource.data.eventId));
      allow update, delete: if isAdmin() || (ownsDocByEventId(resource.data) && hasPerm('certificates', 'canManage'));
    }
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationCount']) &&
        request.resource.data.verificationCount == resource.data.verificationCount + 1;
      allow delete: if isAdmin();
    }
    match /feedbackTokens/{tokenId} { allow read, write: if false; }
    match /feedback/{feedbackId} { allow read: if canManageDocByEventId(resource.data) && (isAdmin() || hasPerm('feedback', 'canRead')); allow create, update, delete: if false; }
    match /activity_logs/{logId} { allow read: if canManageDocByEventId(resource.data); allow create, update, delete: if false; }
    match /audit_logs/{logId} { allow read, write: if false; }
    match /event_analytics/{analyticsId} {
      allow read: if canManageEvent(analyticsId);
      allow write: if false;
    }
    match /paymentProofs/{proofId} {
      allow read: if ('eventId' in resource.data) && resource.data.eventId is string && (isAdmin() || (ownsEvent(resource.data.eventId) && hasPerm('payments', 'canVerify')));
      allow create: if false;
      allow update: if ('eventId' in resource.data) && ('eventId' in request.resource.data) &&
        resource.data.eventId == request.resource.data.eventId && (isAdmin() || (ownsEvent(resource.data.eventId) && hasPerm('payments', 'canVerify')));
      allow delete: if ('eventId' in resource.data) && resource.data.eventId is string && (isAdmin() || (ownsEvent(resource.data.eventId) && hasPerm('payments', 'canVerify')));
    }
    match /system/{docId} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
