# Local development uses Mailpit and never contacts Resend.
EMAIL_TRANSPORT=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
FROM_EMAIL=apohub@localhost.test
SENDER_NAME=APOHUB Local

# Production only. Keep this out of local emulator files.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=re_your_key
# FROM_EMAIL=noreply@gdgdavao.com

# Email of the single administrator permitted to delete OTHER administrators.
# Mirrors the client's VITE_SUPERUSER_EMAIL, which only decides which button is
# enabled in AdminUsersPage; this one is what deleteUser actually enforces. Both
# halves have to agree or the tier is theatre in either direction.
# SUPERUSER_EMAIL=admin@gdgdavao.org

# Base URL of the deployed web application (used in emails and Google Wallet passes)
# APP_URL=https://apohub.gdgdavao.org

# Google Wallet Passes Configuration (Numeric Issuer ID from Google Pay & Wallet Console)
# WALLET_ISSUER_ID=33880000000XXXX
# WALLET_LOGO_URL=https://assets.gdgdavao.org/gdg-logo.png
# WALLET_ISSUER_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"placeholder","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n","client_email":"wallet-issuer@your-project-id.iam.gserviceaccount.com"}
