{
  "name": "apohub-gdgdavao",
  "private": true,
  "version": "1.5.5",
  "description": "TeamApo Hub — GDG Davao Event Lifecycle Management Platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "VITE_USE_FIREBASE_EMULATORS=false VITE_USE_EMULATOR=false vite",
    "dev:emulator": "VITE_USE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-apohub vite",
    "build": "vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:dom": "vitest run --project dom",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:run": "bash scripts/firebase-local.sh emulators:exec --config firebase.rules-test.json --project demo-apohub-rules-test --only firestore \"bun run test:rules\"",
    "test:all": "bun run test:rules:run && bun run test:unit && bun run test:dom",
    "emulator:start": "bash scripts/firebase-local.sh emulators:start --project demo-apohub --only auth,firestore,functions,storage",
    "emulator:start:import": "bash scripts/firebase-local.sh emulators:start --only auth,firestore,functions,storage --import=./emulator-data",
    "emulator:export": "bash scripts/firebase-local.sh emulators:export ./emulator-data",
    "emulator:clear": "bash scripts/firebase-local.sh emulators:start --only auth,firestore,functions,storage --import=./emulator-data --export-on-exit",
    "sample-data": "bun scripts/populate-sample-data.cjs",
    "sample-users": "bun scripts/populate-users-only.cjs",
    "emulator:with-data": "bun run emulator:start && bun run sample-data",
    "emulator:with-users": "bun run emulator:start && bun run sample-users",
    "dev:apohub": "bun scripts/apohub.mjs dev",
    "dev:full": "bun run dev:apohub",
    "firebase:setup": "bash scripts/quick-setup.sh",
    "firebase:deploy": "bash scripts/deploy-firebase.sh",
    "firebase:validate": "node scripts/validate-setup.js",
    "firebase:init-db": "node scripts/init-database.js",
    "firebase:backfill-organizer-uid": "node scripts/backfill-organizer-uid.cjs",
    "firebase:export-certificate-emails": "node scripts/export-certificate-emails.cjs",
    "firebase:scrub-certificate-emails": "node scripts/scrub-certificate-emails.cjs",
    "firebase:scrub-event-promo-codes": "bun scripts/scrub-event-promo-codes.cjs",
    "firebase:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:indexes": "firebase deploy --only firestore:indexes",
    "firebase:functions": "firebase deploy --only functions",
    "firebase:rules:generate": "node scripts/deploy-rules.js generate",
    "firebase:rules:deploy": "node scripts/deploy-rules.js deploy",
    "firebase:rules:validate": "node scripts/deploy-rules.js validate",
    "firebase:rules:status": "node scripts/deploy-rules.js status",
    "firebase:rules:all": "node scripts/deploy-rules.js all",
    "firebase:indexes:generate": "node scripts/deploy-indexes.js generate",
    "firebase:indexes:deploy": "node scripts/deploy-indexes.js deploy",
    "firebase:indexes:validate": "node scripts/deploy-indexes.js validate",
    "firebase:indexes:status": "node scripts/deploy-indexes.js status",
    "firebase:indexes:all": "node scripts/deploy-indexes.js all",
    "mcp": "bun run scripts/mcp/server.ts",
    "memory:mcp": "bun run scripts/mcp/memory-server.ts",
    "firebase:mcp": "firebase mcp",
    "devtools:mcp": "bunx chrome-devtools-mcp@latest",
    "email:test:mailpit": "USE_MAILPIT=true functions/venv/bin/python3 functions/test_email.py",
    "email:test:resend": "functions/venv/bin/python3 functions/test_email.py",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 versions",
    "iOS >= 15.4",
    "Safari >= 15.4",
    "not dead"
  ],
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@casl/react": "^7.0.1",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@vercel/analytics": "^1.5.0",
    "@vitejs/plugin-rsc": "^0.5.5",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jest": "^30.1.3",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "mime": "^4.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.3",
    "vercel": "^49.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "^1.0.30001815",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.32.1",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.1",
    "pyright": "^1.1.414",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  }
}
