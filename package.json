{
  "name": "apohub-gdgdavao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "VITE_USE_EMULATOR=true vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulator:start": "firebase emulators:start --only auth,firestore,functions,storage",
    "emulator:start:import": "firebase emulators:start --only auth,firestore,functions,storage --import=./emulator-data",
    "emulator:export": "firebase emulators:export ./emulator-data",
    "emulator:clear": "firebase emulators:start --only auth,firestore,functions,storage --import=./emulator-data --export-on-exit",
    "sample-data": "node scripts/populate-sample-data.js",
    "sample-users": "node scripts/populate-users-only.cjs",
    "emulator:with-data": "npm run emulator:start && npm run sample-data",
    "emulator:with-users": "npm run emulator:start && npm run sample-users",
    "dev:full": "concurrently \"npm run emulator:start\" \"npm run dev:emulator\"",
    "firebase:setup": "bash scripts/quick-setup.sh",
    "firebase:deploy": "bash scripts/deploy-firebase.sh",
    "firebase:validate": "node scripts/validate-setup.js",
    "firebase:init-db": "node scripts/init-database.js",
    "firebase:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:indexes": "firebase deploy --only firestore:indexes",
    "firebase:functions": "firebase deploy --only functions",
    "firebase:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:rules:generate": "node scripts/deploy-rules.js generate",
    "firebase:rules:deploy": "node scripts/deploy-rules.js deploy",
    "firebase:rules:validate": "node scripts/deploy-rules.js validate",
    "firebase:rules:status": "node scripts/deploy-rules.js status",
    "firebase:rules:all": "node scripts/deploy-rules.js all",
    "firebase:indexes:generate": "node scripts/deploy-indexes.js generate",
    "firebase:indexes:deploy": "node scripts/deploy-indexes.js deploy",
    "firebase:indexes:validate": "node scripts/deploy-indexes.js validate",
    "firebase:indexes:status": "node scripts/deploy-indexes.js status",
    "firebase:indexes:all": "node scripts/deploy-indexes.js all"
  },
  "dependencies": {
    "@google/genai": "^1.15.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.469.0",
    "mime": "^4.0.7",
    "postcss": "^8.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^13.4.0",
    "globals": "^16.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  }
}
