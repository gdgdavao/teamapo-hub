rules_version = '2';

// DEVELOPMENT STORAGE RULES - More permissive for testing
// DO NOT USE IN PRODUCTION

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow all reads (for development)
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow authenticated users to write to most paths
    match /events/{eventId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /event-images/{eventId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /payment-qr/{eventId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /payment-proofs/{registrationId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /certificate-templates/{templateId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /certificates/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /profile-pictures/{userId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /system/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    match /registrations/{registrationId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    // Allow deletes for authenticated users
    match /{allPaths=**} {
      allow delete: if request.auth != null;
    }
  }
}
